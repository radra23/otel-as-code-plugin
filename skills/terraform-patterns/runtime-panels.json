{
  "_comment": "Runtime panel row per language (#277): the single source of truth for which runtime metrics the generated dashboards chart. Only metrics the trace-flow e2e job saw arrive are listed. 'grafana' is the PromQL as it is stored by Prometheus (dots to underscores, unit suffix, _total on a counter); every one is run against the local stack's Prometheus in tests/e2e/run.sh. 'stability' is the metric name's level in the semantic conventions at SEMCONV_VERSION (see language-maturity).",
  "languages": {
    "nodejs": {
      "label": "Node.js",
      "panels": [
        {
          "title": "Heap used",
          "metric": "v8js.memory.heap.used",
          "kind": "updowncounter",
          "unit": "By",
          "stability": "development",
          "grafanaUnit": "bytes",
          "grafana": "sum(v8js_memory_heap_used_bytes{job=\"${var.service_name}\"})"
        },
        {
          "title": "Event loop delay (p99)",
          "metric": "nodejs.eventloop.delay.p99",
          "kind": "gauge",
          "unit": "s",
          "stability": "development",
          "grafanaUnit": "s",
          "grafana": "max(nodejs_eventloop_delay_p99_seconds{job=\"${var.service_name}\"})"
        },
        {
          "title": "Event loop utilization",
          "metric": "nodejs.eventloop.utilization",
          "kind": "gauge",
          "unit": "1",
          "stability": "development",
          "grafanaUnit": "percentunit",
          "grafana": "max(nodejs_eventloop_utilization_ratio{job=\"${var.service_name}\"})"
        },
        {
          "title": "Garbage collections per second",
          "metric": "v8js.gc.duration",
          "kind": "histogram",
          "unit": "s",
          "stability": "development",
          "grafanaUnit": "ops",
          "grafana": "sum(rate(v8js_gc_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
        }
      ]
    },
    "python": {
      "label": "Python",
      "panels": [
        {
          "title": "Memory (resident)",
          "metric": "process.memory.usage",
          "kind": "updowncounter",
          "unit": "By",
          "stability": "release_candidate",
          "grafanaUnit": "bytes",
          "grafana": "sum(process_memory_usage_bytes{job=\"${var.service_name}\"})"
        },
        {
          "title": "CPU utilization",
          "metric": "process.cpu.utilization",
          "kind": "gauge",
          "unit": "1",
          "stability": "development",
          "grafanaUnit": "percentunit",
          "grafana": "max(process_cpu_utilization_ratio{job=\"${var.service_name}\"})"
        },
        {
          "title": "Threads",
          "metric": "process.thread.count",
          "kind": "updowncounter",
          "unit": "{thread}",
          "stability": "release_candidate",
          "grafanaUnit": "short",
          "grafana": "sum(process_thread_count{job=\"${var.service_name}\"})"
        },
        {
          "title": "Garbage collections per second",
          "metric": "cpython.gc.collections",
          "kind": "counter",
          "unit": "{collection}",
          "stability": "development",
          "grafanaUnit": "ops",
          "grafana": "sum(rate(cpython_gc_collections_total{job=\"${var.service_name}\"}[5m]))"
        }
      ]
    },
    "java": {
      "label": "JVM",
