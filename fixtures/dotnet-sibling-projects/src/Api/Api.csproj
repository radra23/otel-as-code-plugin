<!-- Api — the host project. Regression fixture for #205: the ActivitySource it reports via
     existingOtel is NOT in this project's own directory (rootDir) — it lives in the sibling
     Api.Domain class library below, reached only via the ProjectReference. A rootDir-only glob
     never sees it. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Api.Domain/Api.Domain.csproj" />
  </ItemGroup>

</Project>
