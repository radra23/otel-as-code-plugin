# Local secrets — never commit (e.g. live vendor credentials for tests/tf-live/)
.env
.env.*
!.env.example

# Session & dev artifacts (not part of the plugin)
.remember/
.superpowers/

# Internal planning/design docs — kept locally, not shipped in the public repo
docs/

# Local Claude Code settings
.claude/settings.local.json

# Ephemeral otel-as-code runtime files
.claude/.otel-force
.claude/otel-context.json

# Local review/critique reports — kept locally, not shipped in the public repo
.claude/reviews/

# Personal Claude notes
.claude.local.md

# Python bytecode (hooks/codex adapters, scripts)
__pycache__/
*.pyc

# Generated by scripts/drift_check.py
drift-report.md

# E2E harness throwaway app copies (tests/e2e/run.sh seeds/removes this on every run)
tests/e2e/.work/
