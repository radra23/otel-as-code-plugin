{
    "name": "acme/billing-api",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "open-telemetry/api": "^1.12.0",
        "open-telemetry/context": "^1.6.0",
        "open-telemetry/sdk": "^1.17.0",
        "open-telemetry/sem-conv": "^1.45.0",
        "open-telemetry/exporter-otlp": "^1.6.0",
        "open-telemetry/opentelemetry-auto-laravel": "^1.10.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["telemetry.php"]
    },
    "config": {
        "allow-plugins": {
            "tbachert/spi": true
        }
    }
}
