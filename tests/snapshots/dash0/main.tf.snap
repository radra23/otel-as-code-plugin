# Generated by otel-as-code v0.1.0 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend dash0 to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/dash0
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# Self-contained (declares its own variables) so CI can `terraform validate` main.tf
# in isolation. The plugin emits variables.tf / outputs.tf alongside this file for real runs.
# Dash0 is OTel-native: dashboards/check rules are opaque YAML, so OTel semconv attribute
# names are used directly in the PromQL queries with no translation layer.

terraform {
  required_providers {
    dash0 = {
      source  = "dash0hq/dash0"
      version = "~> 1.0"
    }
  }
  required_version = ">= 1.5"
}

variable "dash0_auth_token" {
  description = "Dash0 API auth token (must start with \"auth_\" or \"dash0_at_\"). Requires management/write API access, NOT an ingestion-only scope (this module creates dashboards/check rules) — a 403 on every resource means check the token's permission scope. Create one under Organization Settings > Auth Tokens."
  type        = string
  sensitive   = true
  default     = ""
}

variable "dash0_url" {
  description = "Dash0 API endpoint (region-specific)"
  type        = string
  default     = "https://api.us-west-2.aws.dash0.com"
}

variable "dash0_dataset" {
  description = "Dash0 dataset identifier (not display name). A data-partitioning concept, UNRELATED to the shared `environment` variable — never default this to \"production\" (not a dataset Dash0 provisions; produces a 403 that reads like a permissions failure but isn't). A fresh org's actual default dataset is named \"default\"."
  type        = string
  default     = "default"
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

provider "dash0" {
  auth_token = var.dash0_auth_token
  url        = var.dash0_url
}

locals {
  # npm-scoped service names ("@myorg/web") carry '@' and '/' that are invalid in resource
  # identifiers. service_slug sanitizes service.name to [a-z0-9_] for IDENTIFIER positions only
  # (the alert names below). Every PromQL filter keeps the raw var.service_name so it still
  # matches the emitted service.name value — sanitizing there would break the match.
  service_slug = trim(replace(lower(var.service_name), "/[^a-z0-9]+/", "_"), "_")
  # dash0_check_rule's check_rule_yaml embeds a PrometheusRule doc, whose metadata.name follows
  # Kubernetes object-naming convention (DNS-1123: lowercase alphanumeric + '-', NO underscores) —
  # a separate constraint from the `alert:` field below (a free-text Prometheus label value, where
  # service_slug's underscores are fine, confirmed live: only the missing PrometheusRule envelope
  # broke apply, not the alert name's underscores).
  resource_name_slug = trim(replace(lower(var.service_name), "/[^a-z0-9]+/", "-"), "-")
}

resource "dash0_dashboard" "otel" {
  dataset = var.dash0_dataset

  dashboard_yaml = <<-YAML
    kind: Dashboard
    spec:
      display:
        name: ${var.service_name} — OpenTelemetry
      panels:
        requestRate:
          kind: Panel
          spec:
            display:
              name: Request rate
            plugin:
              kind: TimeSeriesChart
            queries:
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum(rate(http_server_request_duration_seconds_count{service_name="${var.service_name}"}[5m]))
        errorRate:
          kind: Panel
          spec:
            display:
              name: Error rate (5xx)
            plugin:
              kind: TimeSeriesChart
            queries:
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum(rate(http_server_request_duration_seconds_count{service_name="${var.service_name}",http_response_status_code=~"5.."}[5m]))
        p99Latency:
          kind: Panel
          spec:
            display:
              name: p99 latency
            plugin:
              kind: TimeSeriesChart
            queries:
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name="${var.service_name}"}[5m])) by (le))
  YAML
}

resource "dash0_check_rule" "error_rate" {
  dataset = var.dash0_dataset

  # check_rule_yaml MUST be a full PrometheusRule doc (apiVersion/kind/metadata/spec.groups) — a
  # flat alert-only body (no groups wrapper) fails live apply with "error converting check rule
  # YAML to Dash0 format: currently only one group is supported" (confirmed via a live apply).
  # Dash0 currently supports exactly ONE group containing exactly ONE rule per check_rule_yaml.
  check_rule_yaml = <<-YAML
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      name: ${local.resource_name_slug}-high-error-rate
    spec:
      groups:
        - name: Alerting
          rules:
            - alert: HighErrorRate_${local.service_slug}
              expr: |
                sum(rate(http_server_request_duration_seconds_count{service_name="${var.service_name}",http_response_status_code=~"5.."}[5m]))
                / sum(rate(http_server_request_duration_seconds_count{service_name="${var.service_name}"}[5m])) > 0.05
              for: 5m
              labels:
                severity: critical
                service: ${var.service_name}
              annotations:
                summary: 5xx error rate above 5% for ${var.service_name}
  YAML
}

resource "dash0_check_rule" "latency" {
  dataset = var.dash0_dataset

  check_rule_yaml = <<-YAML
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      name: ${local.resource_name_slug}-high-p99-latency
    spec:
      groups:
        - name: Alerting
          rules:
            - alert: HighP99Latency_${local.service_slug}
              expr: |
                histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name="${var.service_name}"}[5m])) by (le)) > 0.5
              for: 5m
              labels:
                severity: warning
                service: ${var.service_name}
              annotations:
                summary: p99 latency above 500ms for ${var.service_name}
  YAML
}
