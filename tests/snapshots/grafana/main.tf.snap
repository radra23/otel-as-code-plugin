# Generated by otel-as-code v0.1.0 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend grafana to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/grafana
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# This golden snapshot is self-contained (declares its own variables) so CI can
# `terraform validate` main.tf in isolation. The plugin emits variables.tf / outputs.tf
# alongside this file when run for real.

terraform {
  required_providers {
    grafana = {
      source  = "grafana/grafana"
      version = "~> 4.0"
    }
  }
  required_version = ">= 1.5"
}

variable "grafana_url" {
  description = "Grafana Cloud URL (e.g. https://yourorg.grafana.net)"
  type        = string
  default     = "https://example.grafana.net"
}

variable "grafana_service_account_token" {
  description = "Service account token with Editor role"
  type        = string
  sensitive   = true
  default     = ""
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

variable "prometheus_datasource_uid" {
  description = "UID of the Prometheus/Mimir datasource backing these queries"
  type        = string
  default     = "grafanacloud-prom"
}

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_service_account_token
}

locals {
  # npm-scoped service names ("@myorg/web") carry '@' and '/' that are invalid in a Grafana
  # dashboard/rule-group identifier. service_slug sanitizes service.name to [a-z0-9_] for
  # IDENTIFIER positions only (the dashboard uid + rule-group name). PromQL `job=` filters keep
  # the raw var.service_name so they still match the emitted service.name→job value.
  service_slug = trim(replace(lower(var.service_name), "/[^a-z0-9]+/", "_"), "_")
}

resource "grafana_folder" "otel" {
  title = "OTel — ${var.service_name}"
}

resource "grafana_dashboard" "otel" {
  folder = grafana_folder.otel.uid
  config_json = jsonencode({
    title         = "${var.service_name} — OpenTelemetry"
    uid           = "otel-${local.service_slug}"
    schemaVersion = 39
    time          = { from = "now-6h", to = "now" }
    panels = [
      {
        title   = "Request rate"
        type    = "timeseries"
        gridPos = { h = 8, w = 12, x = 0, y = 0 }
        targets = [{
          refId = "A"
          expr  = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
        }]
      },
      {
        title   = "Error rate (5xx)"
        type    = "timeseries"
        gridPos = { h = 8, w = 12, x = 12, y = 0 }
        targets = [{
          refId = "A"
          expr  = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[5m]))"
        }]
      },
      {
        title   = "p99 latency"
        type    = "timeseries"
        gridPos = { h = 8, w = 24, x = 0, y = 8 }
        targets = [{
          refId = "A"
          expr  = "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"${var.service_name}\"}[5m])) by (le))"
        }]
      },
    ]
  })
}

resource "grafana_rule_group" "otel" {
  name             = "otel-${local.service_slug}"
  folder_uid       = grafana_folder.otel.uid
  interval_seconds = 60

  rule {
    name           = "High 5xx error rate — ${var.service_name}"
    condition      = "C"
    no_data_state  = "NoData"
    exec_err_state = "Error"
    for            = "5m"

    data {
      ref_id         = "A"
      datasource_uid = var.prometheus_datasource_uid
      relative_time_range {
        from = 600
        to   = 0
      }
      model = jsonencode({
        refId      = "A"
        datasource = { type = "prometheus", uid = var.prometheus_datasource_uid }
        instant    = false
        range      = true
        expr       = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
      })
    }

    # Grafana unified alerting requires query -> reduce -> threshold. Ref A is a range query
    # (a time series); ref B reduces it to a single value so ref C's threshold can evaluate.
    # Wiring a threshold straight onto a multi-point series fails at rule evaluation.
    data {
      ref_id         = "B"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "B"
        type       = "reduce"
        expression = "A"
        reducer    = "last"
      })
    }

    data {
      ref_id         = "C"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "C"
        type       = "threshold"
        expression = "B"
        conditions = [{
          evaluator = { type = "gt", params = [0.05] }
        }]
      })
    }
  }
}

resource "grafana_slo" "otel" {
  name        = "${var.service_name} availability"
  description = "99.9% of requests to ${var.service_name} are non-5xx over 30d."

  query {
    type = "freeform"
    freeform {
      query = "1 - (sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[5m])))"
    }
  }

  objectives {
    value  = 0.999
    window = "30d"
  }

  destination_datasource {
    uid = var.prometheus_datasource_uid
  }
}
