# Generated by otel-as-code v0.1.0 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend datadog to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/datadog
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# Self-contained (declares its own variables) so CI can `terraform validate` main.tf
# in isolation. The plugin emits variables.tf / outputs.tf alongside this file for real runs.

terraform {
  required_providers {
    datadog = {
      source  = "DataDog/datadog"
      version = "~> 3.0"
    }
  }
  required_version = ">= 1.5"
}

variable "datadog_api_key" {
  description = "Datadog API key"
  type        = string
  sensitive   = true
  default     = ""
}

variable "datadog_app_key" {
  description = "Datadog application key"
  type        = string
  sensitive   = true
  default     = ""
}

variable "datadog_site" {
  description = "Datadog site (e.g. datadoghq.com, datadoghq.eu)"
  type        = string
  default     = "datadoghq.com"
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

provider "datadog" {
  api_key = var.datadog_api_key
  app_key = var.datadog_app_key
  api_url = "https://api.${var.datadog_site}/"
}

resource "datadog_dashboard" "otel" {
  title       = "${var.service_name} — OpenTelemetry"
  layout_type = "ordered"

  widget {
    timeseries_definition {
      title = "Request rate"
      request {
        q            = "sum:trace.http.request.hits{service:${var.service_name}}.as_rate()"
        display_type = "line"
      }
    }
  }

  widget {
    timeseries_definition {
      title = "Error rate"
      request {
        q            = "sum:trace.http.request.errors{service:${var.service_name}}.as_rate()"
        display_type = "line"
      }
    }
  }

  widget {
    timeseries_definition {
      title = "p99 latency"
      request {
        q            = "p99:trace.http.request.duration{service:${var.service_name}}"
        display_type = "line"
      }
    }
  }
}

resource "datadog_monitor" "error_rate" {
  name    = "High error rate — ${var.service_name}"
  type    = "query alert"
  message = "5xx error rate for ${var.service_name} is above 5%. Notify @your-team."
  query   = "sum(last_5m):sum:trace.http.request.errors{service:${var.service_name}}.as_rate() / sum:trace.http.request.hits{service:${var.service_name}}.as_rate() > 0.05"

  monitor_thresholds {
    critical = 0.05
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}

resource "datadog_monitor" "latency" {
  name    = "High p99 latency — ${var.service_name}"
  type    = "metric alert"
  message = "p99 latency for ${var.service_name} is above 500ms. Notify @your-team."
  query   = "avg(last_5m):p99:trace.http.request.duration{service:${var.service_name}} > 0.5"

  monitor_thresholds {
    critical = 0.5
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}

resource "datadog_service_level_objective" "availability" {
  name        = "${var.service_name} availability"
  type        = "metric"
  description = "99.9% of requests to ${var.service_name} are non-error over 30d."

  query {
    numerator   = "sum:trace.http.request.hits{service:${var.service_name}}.as_count() - sum:trace.http.request.errors{service:${var.service_name}}.as_count()"
    denominator = "sum:trace.http.request.hits{service:${var.service_name}}.as_count()"
  }

  thresholds {
    timeframe = "30d"
    target    = 99.9
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}
