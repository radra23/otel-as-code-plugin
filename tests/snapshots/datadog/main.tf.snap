# Generated by otel-as-code v0.25.18 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend datadog to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/datadog
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# Self-contained (declares its own variables) so CI can `terraform validate` main.tf
# in isolation. The plugin emits variables.tf / outputs.tf alongside this file for real runs.
#
# APM metric names: these queries use the trace metric stem `trace.http.server.request.*`,
# the Datadog operation name assigned to OTel HTTP server spans under operation-name logic v2
# (default on OTel Collector >= v0.126.0 / Datadog Agent >= v7.65). On older pipelines, or if a
# transform processor sets operation.name, the stem differs — confirm yours in Datadog under
# APM > Metrics (Metrics Explorer, search `trace.`) before relying on these monitors/SLO.
# Latency thresholds are in NANOSECONDS (500000000 = 500ms).

terraform {
  required_providers {
    datadog = {
      source  = "DataDog/datadog"
      version = "~> 4.0"
    }
  }
  required_version = ">= 1.5"
}

variable "datadog_api_key" {
  description = "Datadog API key"
  type        = string
  sensitive   = true
  default     = ""
}

variable "datadog_app_key" {
  description = "Datadog application key"
  type        = string
  sensitive   = true
  default     = ""
}

variable "datadog_site" {
  description = "Datadog site (e.g. datadoghq.com, datadoghq.eu)"
  type        = string
  default     = "datadoghq.com"
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

variable "error_log_ratio_threshold" {
  description = "The error-log monitor alerts when more than this share of the service's log lines are at status error or above for 5 minutes (0.05 = 5%)"
  type        = number
  default     = 0.05
}

provider "datadog" {
  api_key = var.datadog_api_key
  app_key = var.datadog_app_key
  api_url = "https://api.${var.datadog_site}/"
}

resource "datadog_dashboard" "otel" {
  title       = "${var.service_name} — OpenTelemetry"
  layout_type = "ordered"

  widget {
    timeseries_definition {
      title = "Request rate"
      request {
        q            = "sum:trace.http.server.request.hits{service:${var.service_name}}.as_rate()"
        display_type = "line"
      }
    }
  }

  widget {
    timeseries_definition {
      title = "Error rate"
      request {
        q            = "sum:trace.http.server.request.errors{service:${var.service_name}}.as_rate()"
        display_type = "line"
      }
    }
  }

  widget {
    timeseries_definition {
      title = "p99 latency"
      request {
        q            = "p99:trace.http.server.request{service:${var.service_name}}"
        display_type = "line"
      }
    }
  }

  widget {
    log_stream_definition {
      title               = "Logs"
      description         = "Empty until the service exports its logs over OTLP. Written from Datadog's OTLP log mapping; not run against a Datadog account."
      query               = "service:${var.service_name}"
      show_date_column    = true
      show_message_column = true
      message_display     = "inline"
      sort {
        column = "time"
        order  = "desc"
      }
    }
  }
}

resource "datadog_monitor" "error_rate" {
  name    = "High error rate — ${var.service_name}"
  type    = "query alert"
  message = "More than 5% of requests to ${var.service_name} are failing. Likely causes: a recent deploy, a dependency failing or timing out (database, queue, another service), or the service running out of memory or connections. Check first: find on the dashboard when the rise started, then open the failing traces from that time: the first span with an error names the call that failed. Notify @your-team."
  query   = "sum(last_5m):sum:trace.http.server.request.errors{service:${var.service_name}}.as_rate() / sum:trace.http.server.request.hits{service:${var.service_name}}.as_rate() > 0.05"

  monitor_thresholds {
    critical = 0.05
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}

resource "datadog_monitor" "latency" {
  name    = "High p99 latency — ${var.service_name}"
  type    = "metric alert"
  message = "The slowest 1% of requests to ${var.service_name} take longer than 500 ms. Likely causes: a slow dependency, CPU or memory pressure (garbage collection included), or more traffic than the service can serve. Check first: find on the dashboard when it started and whether traffic rose with it, then open the slowest traces from that time: the longest child span is usually the cause. Notify @your-team."
  query   = "avg(last_5m):p99:trace.http.server.request{service:${var.service_name}} > 500000000"

  monitor_thresholds {
    critical = 500000000
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}

resource "datadog_monitor" "error_logs" {
  name    = "High error-log share — ${var.service_name}"
  type    = "log alert"
  message = "More of the log lines from ${var.service_name} are at ERROR or above than error_log_ratio_threshold allows. Likely causes: errors the service catches and logs without failing the request, a failing dependency, or a new log line written at the wrong level. Check first: find the most frequent error message in the service's logs; a line written during a request carries its trace ID, which opens that request's trace. Notify @your-team."
  query   = "formula(\"errors / total\").last(\"5m\") > ${var.error_log_ratio_threshold}"

  variables {
    event_query {
      data_source = "logs"
      name        = "errors"
      indexes     = ["*"]
      compute {
        aggregation = "count"
      }
      search {
        query = "service:${var.service_name} status:(error OR critical OR alert OR emergency)"
      }
    }
    event_query {
      data_source = "logs"
      name        = "total"
      indexes     = ["*"]
      compute {
        aggregation = "count"
      }
      search {
        query = "service:${var.service_name}"
      }
    }
  }

  monitor_thresholds {
    critical = var.error_log_ratio_threshold
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}

resource "datadog_service_level_objective" "availability" {
  name        = "${var.service_name} availability"
  type        = "metric"
  description = "99.9% of requests to ${var.service_name} are non-error over 30d."

  query {
    numerator   = "sum:trace.http.server.request.hits{service:${var.service_name}}.as_count() - sum:trace.http.server.request.errors{service:${var.service_name}}.as_count()"
    denominator = "sum:trace.http.server.request.hits{service:${var.service_name}}.as_count()"
  }

  thresholds {
    timeframe = "30d"
    target    = 99.9
  }

  tags = ["service:${var.service_name}", "managed-by:otel-as-code"]
}
