# Generated by otel-as-code v0.25.2 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend newrelic to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/newrelic
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# Self-contained (declares its own variables) so CI can `terraform validate` main.tf
# in isolation. The plugin emits variables.tf / outputs.tf alongside this file for real runs.

terraform {
  required_providers {
    newrelic = {
      source  = "newrelic/newrelic"
      version = "~> 3.0"
    }
  }
  required_version = ">= 1.5"
}

variable "newrelic_account_id" {
  description = "New Relic account ID"
  type        = number
  default     = 0
}

variable "newrelic_api_key" {
  description = "New Relic User API key (NRAK-...)"
  type        = string
  sensitive   = true
  default     = ""
}

variable "newrelic_region" {
  description = "New Relic region: US or EU"
  type        = string
  default     = "US"
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

variable "service_entity_guid" {
  description = "GUID of the New Relic entity the SLI attaches to (from the APM/OTel service)"
  type        = string
  default     = "MXxBUE18QVBQTElDQVRJT058MQ"
}

variable "error_log_ratio_threshold" {
  description = "The error-log alert fires when more than this share of the service's log lines are at severity ERROR or above for 5 minutes (0.05 = 5%)"
  type        = number
  default     = 0.05
}

provider "newrelic" {
  account_id = var.newrelic_account_id
  api_key    = var.newrelic_api_key
  region     = var.newrelic_region
}

resource "newrelic_alert_policy" "otel" {
  name = "OTel — ${var.service_name}"
}

resource "newrelic_nrql_alert_condition" "error_rate" {
  account_id = var.newrelic_account_id
  policy_id  = newrelic_alert_policy.otel.id
  type       = "static"
  name       = "High error rate — ${var.service_name}"

  description = "More than 5% of requests to ${var.service_name} are failing. Likely causes: a recent deploy, a dependency failing or timing out (database, queue, another service), or the service running out of memory or connections. Check first: find on the dashboard when the rise started, then open the failing traces from that time: the first span with an error names the call that failed. Dashboard: ${newrelic_one_dashboard.otel.permalink}"

  nrql {
    query = "SELECT filter(count(*), WHERE otel.status_code = 'ERROR') / count(*) FROM Span WHERE service.name = '${var.service_name}'"
  }

  critical {
    operator              = "above"
    threshold             = 0.05
    threshold_duration    = 300
    threshold_occurrences = "all"
  }
}

resource "newrelic_nrql_alert_condition" "latency" {
  account_id = var.newrelic_account_id
  policy_id  = newrelic_alert_policy.otel.id
  type       = "static"
  name       = "High p99 latency — ${var.service_name}"

  description = "The slowest 1% of requests to ${var.service_name} take longer than 500 ms. Likely causes: a slow dependency, CPU or memory pressure (garbage collection included), or more traffic than the service can serve. Check first: find on the dashboard when it started and whether traffic rose with it, then open the slowest traces from that time: the longest child span is usually the cause. Dashboard: ${newrelic_one_dashboard.otel.permalink}"

  nrql {
    query = "SELECT percentile(duration.ms, 99) FROM Span WHERE service.name = '${var.service_name}'"
  }

  critical {
    operator              = "above"
    threshold             = 500
    threshold_duration    = 300
    threshold_occurrences = "all"
  }
}

# Error logs: the share of this service's log lines at severity ERROR or above. New Relic keeps an
# OTLP log record's severity number as `severity.number` (17 to 24 is ERROR and FATAL in every
# language, where the severity text is not). Written from New Relic's documented OTLP mapping;
# not run against live data. It has data only when the service exports its logs.
resource "newrelic_nrql_alert_condition" "error_logs" {
  account_id = var.newrelic_account_id
  policy_id  = newrelic_alert_policy.otel.id
  type       = "static"
  name       = "High error-log share: ${var.service_name}"

  description = "More of the log lines from ${var.service_name} are at ERROR or above than error_log_ratio_threshold allows. Likely causes: errors the service catches and logs without failing the request, a failing dependency, or a new log line written at the wrong level. Check first: find the most frequent error message in the service's logs; a line written during a request carries its trace ID, which opens that request's trace. Dashboard: ${newrelic_one_dashboard.otel.permalink}"

  nrql {
    query = "SELECT filter(count(*), WHERE severity.number >= 17) / count(*) FROM Log WHERE service.name = '${var.service_name}'"
  }

  critical {
    operator              = "above"
    threshold             = var.error_log_ratio_threshold
    threshold_duration    = 300
    threshold_occurrences = "all"
  }
}

resource "newrelic_one_dashboard" "otel" {
  name = "${var.service_name} — OpenTelemetry"

  page {
    name = "Overview"

    widget_line {
      title  = "Request rate"
      row    = 1
      column = 1
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT rate(count(*), 1 minute) FROM Span WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_line {
      title  = "p99 latency (ms)"
      row    = 1
      column = 5
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT percentile(duration.ms, 99) FROM Span WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }
  }

  # Runtime page: chosen by the service's language from terraform-patterns'
  # runtime-panels.json. New Relic stores a metric under its OpenTelemetry name, so each query
  # follows from the table's metric and kind. None of them has been run against live data.
  page {
    name = "Runtime (Node.js)"

    widget_line {
      title  = "Heap used"
      row    = 1
      column = 1
      width  = 3
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT average(`v8js.memory.heap.used`) FROM Metric WHERE service.name = '${var.service_name}' FACET `v8js.heap.space.name` TIMESERIES"
      }
    }

    widget_line {
      title  = "Event loop delay (p99)"
      row    = 1
      column = 4
      width  = 3
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT average(`nodejs.eventloop.delay.p99`) FROM Metric WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_line {
      title  = "Event loop utilization"
      row    = 1
      column = 7
      width  = 3
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT average(`nodejs.eventloop.utilization`) FROM Metric WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_line {
      title  = "Garbage collections per second"
      row    = 1
      column = 10
      width  = 3
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT rate(count(`v8js.gc.duration`), 1 second) FROM Metric WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_markdown {
      title  = "About this page"
      row    = 4
      column = 1
      width  = 12
      height = 2
      text   = "Runtime metrics the generated bootstrap emits with no application code. These queries were derived from the metric names and were not run against a New Relic account: if a chart is empty, look the metric up in the Metrics explorer. Names not yet stable in the OpenTelemetry semantic conventions, which a later SDK release may rename: nodejs.eventloop.delay.p99, nodejs.eventloop.utilization, v8js.gc.duration, v8js.memory.heap.used."
    }
  }

  # Business-attribute panels — one per confirmed businessAttrs entry (example shown here).
  # New Relic queries spans/metrics directly, so these need no metric-label promotion.
  page {
    name = "Business metrics"

    # kind: gauge — a ratio/level read as-is (never sum()/rate() a ratio).
    widget_line {
      title  = "com.example.checkout.conversion_rate"
      row    = 1
      column = 1
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT average(`com.example.checkout.conversion_rate`) FROM Metric WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    # kind: dimension — a native breakdown of traffic by a business attribute on the span.
    widget_bar {
      title  = "Requests by com.example.checkout.customer_tier"
      row    = 1
      column = 5
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT count(*) FROM Span WHERE service.name = '${var.service_name}' FACET `com.example.checkout.customer_tier`"
      }
    }
  }

  # Logs page: the service's own log lines and the share of them that are errors (the alert's
  # query, charted). Attribute names are New Relic's documented mapping of an OTLP log record
  # (message, severity.text, severity.number, trace.id). Not run against live data.
  page {
    name = "Logs"

    widget_log_table {
      title  = "Log lines"
      row    = 1
      column = 1
      width  = 12
      height = 5
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT timestamp, severity.text, message, trace.id FROM Log WHERE service.name = '${var.service_name}'"
      }
    }

    widget_line {
      title  = "Share of error lines"
      row    = 6
      column = 1
      width  = 6
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT filter(count(*), WHERE severity.number >= 17) / count(*) FROM Log WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_markdown {
      title  = "About this page"
      row    = 6
      column = 7
      width  = 6
      height = 3
      text   = "Empty until the service exports its logs over OTLP: in Node.js and Python that needs /otel-instrument --experimental. Lines written during a request carry its trace ID in trace.id. These queries were written from New Relic's documented OTLP log mapping and were not run against a New Relic account."
    }
  }
}

resource "newrelic_service_level" "availability" {
  guid        = var.service_entity_guid
  name        = "${var.service_name} availability"
  description = "99.9% of requests to ${var.service_name} are non-error over 28d."

  events {
    account_id = var.newrelic_account_id

    valid_events {
      from  = "Span"
      where = "service.name = '${var.service_name}'"
    }

    bad_events {
      from  = "Span"
      where = "service.name = '${var.service_name}' AND otel.status_code = 'ERROR'"
    }
  }

  objective {
    target = 99.9
    time_window {
      rolling {
        count = 28
        unit  = "DAY"
      }
    }
  }
}
