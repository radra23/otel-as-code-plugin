# Generated by otel-as-code v0.1.0 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend newrelic to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/newrelic
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# Self-contained (declares its own variables) so CI can `terraform validate` main.tf
# in isolation. The plugin emits variables.tf / outputs.tf alongside this file for real runs.

terraform {
  required_providers {
    newrelic = {
      source  = "newrelic/newrelic"
      version = "~> 3.0"
    }
  }
  required_version = ">= 1.5"
}

variable "newrelic_account_id" {
  description = "New Relic account ID"
  type        = number
  default     = 0
}

variable "newrelic_api_key" {
  description = "New Relic User API key (NRAK-...)"
  type        = string
  sensitive   = true
  default     = ""
}

variable "newrelic_region" {
  description = "New Relic region: US or EU"
  type        = string
  default     = "US"
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

variable "service_entity_guid" {
  description = "GUID of the New Relic entity the SLI attaches to (from the APM/OTel service)"
  type        = string
  default     = "MXxBUE18QVBQTElDQVRJT058MQ"
}

provider "newrelic" {
  account_id = var.newrelic_account_id
  api_key    = var.newrelic_api_key
  region     = var.newrelic_region
}

resource "newrelic_alert_policy" "otel" {
  name = "OTel — ${var.service_name}"
}

resource "newrelic_nrql_alert_condition" "error_rate" {
  account_id = var.newrelic_account_id
  policy_id  = newrelic_alert_policy.otel.id
  type       = "static"
  name       = "High error rate — ${var.service_name}"

  nrql {
    query = "SELECT filter(count(*), WHERE otel.status_code = 'ERROR') / count(*) FROM Span WHERE service.name = '${var.service_name}'"
  }

  critical {
    operator              = "above"
    threshold             = 0.05
    threshold_duration    = 300
    threshold_occurrences = "all"
  }
}

resource "newrelic_nrql_alert_condition" "latency" {
  account_id = var.newrelic_account_id
  policy_id  = newrelic_alert_policy.otel.id
  type       = "static"
  name       = "High p99 latency — ${var.service_name}"

  nrql {
    query = "SELECT percentile(duration.ms, 99) FROM Span WHERE service.name = '${var.service_name}'"
  }

  critical {
    operator              = "above"
    threshold             = 500
    threshold_duration    = 300
    threshold_occurrences = "all"
  }
}

resource "newrelic_one_dashboard" "otel" {
  name = "${var.service_name} — OpenTelemetry"

  page {
    name = "Overview"

    widget_line {
      title  = "Request rate"
      row    = 1
      column = 1
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT rate(count(*), 1 minute) FROM Span WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }

    widget_line {
      title  = "p99 latency (ms)"
      row    = 1
      column = 5
      width  = 4
      height = 3
      nrql_query {
        account_id = var.newrelic_account_id
        query      = "SELECT percentile(duration.ms, 99) FROM Span WHERE service.name = '${var.service_name}' TIMESERIES"
      }
    }
  }
}

resource "newrelic_service_level" "availability" {
  guid        = var.service_entity_guid
  name        = "${var.service_name} availability"
  description = "99.9% of requests to ${var.service_name} are non-error over 28d."

  events {
    account_id = var.newrelic_account_id

    valid_events {
      from  = "Span"
      where = "service.name = '${var.service_name}'"
    }

    bad_events {
      from  = "Span"
      where = "service.name = '${var.service_name}' AND otel.status_code = 'ERROR'"
    }
  }

  objective {
    target = 99.9
    time_window {
      rolling {
        count = 28
        unit  = "DAY"
      }
    }
  }
}
