# Generated by otel-as-code v0.24.8 on 2026-06-21.
# Service: checkout-api v1.4.2
# Re-run /otel-backend grafana --self-hosted to regenerate.
# Drift detection: v2 roadmap.
#
# Next steps:
#   cd infra/observability/grafana
#   terraform init
#   terraform plan    # requires backend credentials in environment
#   terraform apply   # apply only after reviewing the plan
#
# This golden snapshot is self-contained (declares its own variables) so CI can
# `terraform validate` main.tf in isolation. The plugin emits variables.tf / outputs.tf
# alongside this file when run for real.
#
# --self-hosted (#167): no grafana_slo resource — that resource is documented only under
# Grafana Cloud's docs tree, not self-hosted's. The burn-rate rule inside grafana_rule_group.otel
# is the self-hosted substitute; see terraform-patterns' "Self-hosted alternative" section.

terraform {
  required_providers {
    grafana = {
      source  = "grafana/grafana"
      version = "~> 4.0"
    }
  }
  required_version = ">= 1.5"
}

variable "grafana_url" {
  description = "Grafana URL (your self-hosted instance's URL)"
  type        = string
  default     = "https://grafana.example.internal"
}

variable "grafana_service_account_token" {
  description = "Service account token with Editor role"
  type        = string
  sensitive   = true
  default     = ""
}

variable "service_name" {
  description = "OTel service.name — must match the value in your SDK bootstrap"
  type        = string
  default     = "checkout-api"
}

variable "prometheus_datasource_uid" {
  description = "UID of the Prometheus/Mimir datasource backing these queries"
  type        = string
  default     = "prometheus"
}

variable "loki_datasource_uid" {
  description = "UID of the Loki datasource the log panel and the error-log alert query"
  type        = string
  default     = "loki"
}

variable "tempo_datasource_uid" {
  description = "UID of the Tempo datasource every alert's trace-search link opens"
  type        = string
  default     = "tempo"
}

variable "error_log_ratio_threshold" {
  description = "The error-log alert fires when more than this share of the service's log lines are at severity ERROR or above for 5 minutes (0.05 = 5%)"
  type        = number
  default     = 0.05
}

provider "grafana" {
  url  = var.grafana_url
  auth = var.grafana_service_account_token
}

locals {
  # npm-scoped service names ("@myorg/web") carry '@' and '/' that are invalid in a Grafana
  # dashboard/rule-group identifier. service_slug sanitizes service.name to [a-z0-9_] for
  # IDENTIFIER positions only (the dashboard uid + rule-group name). PromQL `job=` filters keep
  # the raw var.service_name so they still match the emitted service.name→job value.
  service_slug = trim(replace(lower(var.service_name), "/[^a-z0-9]+/", "_"), "_")

  # Every alert links to a trace search for the service: Explore on the Tempo datasource, with
  # the same TraceQL query tests/e2e/log-panel.sh runs against the local stack.
  traces_explore_pane = {
    a = {
      datasource = var.tempo_datasource_uid
      queries = [{
        refId      = "A"
        datasource = { type = "tempo", uid = var.tempo_datasource_uid }
        queryType  = "traceql"
        query      = "{resource.service.name=\"${var.service_name}\"}"
      }]
      range = { from = "now-1h", to = "now" }
    }
  }
  traces_explore_url = "${trimsuffix(var.grafana_url, "/")}/explore?schemaVersion=1&panes=${urlencode(jsonencode(local.traces_explore_pane))}"
}

resource "grafana_folder" "otel" {
  title = "OTel — ${var.service_name}"
}

resource "grafana_dashboard" "otel" {
  folder = grafana_folder.otel.uid
  config_json = jsonencode({
    title         = "${var.service_name} — OpenTelemetry"
    uid           = "otel-${local.service_slug}"
    schemaVersion = 39
    time          = { from = "now-6h", to = "now" }
    panels = [
      {
        title   = "Request rate"
        type    = "timeseries"
        gridPos = { h = 8, w = 12, x = 0, y = 0 }
        targets = [{
          refId = "A"
          expr  = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
        }]
      },
      {
        title   = "Error rate (5xx)"
        type    = "timeseries"
        gridPos = { h = 8, w = 12, x = 12, y = 0 }
        targets = [{
          refId = "A"
          expr  = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[5m]))"
        }]
      },
      {
        title   = "p99 latency"
        type    = "timeseries"
        gridPos = { h = 8, w = 24, x = 0, y = 8 }
        targets = [{
          refId = "A"
          expr  = "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{job=\"${var.service_name}\"}[5m])) by (le))"
        }]
      },
      # Runtime row: chosen by the service's language from terraform-patterns'
      # runtime-panels.json. Every query in that table is run against Prometheus in the
      # trace-flow e2e job.
      {
        title     = "Runtime (Node.js)"
        type      = "row"
        collapsed = false
        gridPos   = { h = 1, w = 24, x = 0, y = 16 }
      },
      {
        title       = "Heap used"
        description = "v8js.memory.heap.used, emitted by the generated bootstrap with no application code. Its name is not yet stable in the OpenTelemetry semantic conventions: if the panel goes blank after an SDK upgrade, check whether the metric was renamed."
        type        = "timeseries"
        gridPos     = { h = 8, w = 6, x = 0, y = 17 }
        fieldConfig = { defaults = { unit = "bytes" } }
        targets = [{
          refId = "A"
          expr  = "sum(v8js_memory_heap_used_bytes{job=\"${var.service_name}\"})"
        }]
      },
      {
        title       = "Event loop delay (p99)"
        description = "nodejs.eventloop.delay.p99, emitted by the generated bootstrap with no application code. Its name is not yet stable in the OpenTelemetry semantic conventions: if the panel goes blank after an SDK upgrade, check whether the metric was renamed."
        type        = "timeseries"
        gridPos     = { h = 8, w = 6, x = 6, y = 17 }
        fieldConfig = { defaults = { unit = "s" } }
        targets = [{
          refId = "A"
          expr  = "max(nodejs_eventloop_delay_p99_seconds{job=\"${var.service_name}\"})"
        }]
      },
      {
        title       = "Event loop utilization"
        description = "nodejs.eventloop.utilization, emitted by the generated bootstrap with no application code. Its name is not yet stable in the OpenTelemetry semantic conventions: if the panel goes blank after an SDK upgrade, check whether the metric was renamed."
        type        = "timeseries"
        gridPos     = { h = 8, w = 6, x = 12, y = 17 }
        fieldConfig = { defaults = { unit = "percentunit" } }
        targets = [{
          refId = "A"
          expr  = "max(nodejs_eventloop_utilization_ratio{job=\"${var.service_name}\"})"
        }]
      },
      {
        title       = "Garbage collections per second"
        description = "v8js.gc.duration, emitted by the generated bootstrap with no application code. Its name is not yet stable in the OpenTelemetry semantic conventions: if the panel goes blank after an SDK upgrade, check whether the metric was renamed."
        type        = "timeseries"
        gridPos     = { h = 8, w = 6, x = 18, y = 17 }
        fieldConfig = { defaults = { unit = "ops" } }
        targets = [{
          refId = "A"
          expr  = "sum(rate(v8js_gc_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
        }]
      },
      # Log panel: the service's own lines from Loki. It has data only when the service exports
      # its logs (for Node.js and Python that is /otel-instrument --experimental).
      {
        title       = "Logs"
        description = "Log lines from ${var.service_name}, newest first. Empty until the service exports its logs over OTLP: in Node.js and Python that needs /otel-instrument --experimental. Lines written during a request carry its trace ID."
        type        = "logs"
        gridPos     = { h = 10, w = 24, x = 0, y = 25 }
        datasource  = { type = "loki", uid = var.loki_datasource_uid }
        options     = { showTime = true, sortOrder = "Descending", wrapLogMessage = true }
        targets = [{
          refId = "A"
          expr  = "{service_name=\"${var.service_name}\"}"
        }]
      },
    ]
  })
}

resource "grafana_rule_group" "otel" {
  name             = "otel-${local.service_slug}"
  folder_uid       = grafana_folder.otel.uid
  interval_seconds = 60

  rule {
    name           = "High 5xx error rate — ${var.service_name}"
    condition      = "C"
    no_data_state  = "NoData"
    exec_err_state = "Error"
    for            = "5m"

    annotations = {
      summary     = "More than 5% of requests to ${var.service_name} are failing."
      description = "Likely causes: a recent deploy, a dependency failing or timing out (database, queue, another service), or the service running out of memory or connections. Check first: find on the dashboard when the rise started, then open the failing traces from that time: the first span with an error names the call that failed."
      dashboard   = grafana_dashboard.otel.url
      traces      = local.traces_explore_url
    }

    data {
      ref_id         = "A"
      datasource_uid = var.prometheus_datasource_uid
      relative_time_range {
        from = 600
        to   = 0
      }
      model = jsonencode({
        refId      = "A"
        datasource = { type = "prometheus", uid = var.prometheus_datasource_uid }
        instant    = false
        range      = true
        expr       = "sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[5m]))"
      })
    }

    # Grafana unified alerting requires query -> reduce -> threshold. Ref A is a range query
    # (a time series); ref B reduces it to a single value so ref C's threshold can evaluate.
    # Wiring a threshold straight onto a multi-point series fails at rule evaluation.
    data {
      ref_id         = "B"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "B"
        type       = "reduce"
        expression = "A"
        reducer    = "last"
      })
    }

    data {
      ref_id         = "C"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "C"
        type       = "threshold"
        expression = "B"
        conditions = [{
          evaluator = { type = "gt", params = [0.05] }
        }]
      })
    }
  }

  # Self-hosted substitute for Grafana Cloud's grafana_slo resource (#167): a 1h fast-burn alert
  # at the standard SRE 14.4x threshold (Google SRE Workbook, "Alerting on SLOs") for a 99.9%/30d
  # objective. A deliberate single-window simplification, not a full multi-window SLO dashboard.
  rule {
    name           = "SLO burn rate (1h fast-burn, 14.4x) — ${var.service_name}"
    condition      = "C"
    no_data_state  = "NoData"
    exec_err_state = "Error"
    for            = "5m"

    annotations = {
      summary     = "${var.service_name} is spending its 30-day error budget 14.4 times faster than a 99.9% objective allows: at this pace the budget is gone in about two days."
      description = "Likely causes: the same as for a high error rate, sustained for an hour. Check first: find on the dashboard when failures rose, then open the failing traces from that time: the first span with an error names the call that failed."
      dashboard   = grafana_dashboard.otel.url
      traces      = local.traces_explore_url
    }

    data {
      ref_id         = "A"
      datasource_uid = var.prometheus_datasource_uid
      relative_time_range {
        from = 3600
        to   = 0
      }
      model = jsonencode({
        refId      = "A"
        datasource = { type = "prometheus", uid = var.prometheus_datasource_uid }
        instant    = false
        range      = true
        expr       = "(sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\",http_response_status_code=~\"5..\"}[1h])) / sum(rate(http_server_request_duration_seconds_count{job=\"${var.service_name}\"}[1h]))) / (1 - 0.999)"
      })
    }

    data {
      ref_id         = "B"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "B"
        type       = "reduce"
        expression = "A"
        reducer    = "last"
      })
    }

    data {
      ref_id         = "C"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "C"
        type       = "threshold"
        expression = "B"
        conditions = [{
          evaluator = { type = "gt", params = [14.4] }
        }]
      })
    }
  }

  # Error logs: the share of this service's log lines at severity ERROR or above (OpenTelemetry
  # severity_number 17 to 24, the same in every language, where the severity text is not). A
  # service with no error lines returns no data, which is the healthy state, so NoData is OK.
  rule {
    name           = "High error-log share: ${var.service_name}"
    condition      = "C"
    no_data_state  = "OK"
    exec_err_state = "Error"
    for            = "5m"

    annotations = {
      summary     = "More of the log lines from ${var.service_name} are at ERROR or above than error_log_ratio_threshold allows."
      description = "Likely causes: errors the service catches and logs without failing the request, a failing dependency, or a new log line written at the wrong level. Check first: find the most frequent error message in the service's logs; a line written during a request carries its trace ID, which opens that request's trace."
      dashboard   = grafana_dashboard.otel.url
      traces      = local.traces_explore_url
    }

    data {
      ref_id         = "A"
      datasource_uid = var.loki_datasource_uid
      relative_time_range {
        from = 600
        to   = 0
      }
      model = jsonencode({
        refId      = "A"
        datasource = { type = "loki", uid = var.loki_datasource_uid }
        queryType  = "range"
        expr       = "sum(count_over_time({service_name=\"${var.service_name}\"} | severity_number >= 17 [5m])) / sum(count_over_time({service_name=\"${var.service_name}\"}[5m]))"
      })
    }

    data {
      ref_id         = "B"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "B"
        type       = "reduce"
        expression = "A"
        reducer    = "last"
      })
    }

    data {
      ref_id         = "C"
      datasource_uid = "__expr__"
      relative_time_range {
        from = 0
        to   = 0
      }
      model = jsonencode({
        refId      = "C"
        type       = "threshold"
        expression = "B"
        conditions = [{
          evaluator = { type = "gt", params = [var.error_log_ratio_threshold] }
        }]
      })
    }
  }
}
